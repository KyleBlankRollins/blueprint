{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "source",
    "emitDeclarationOnly": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "source/cli",
    "source/themes",
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/*.spec.ts"
  ]
}