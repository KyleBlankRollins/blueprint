---
/**
 * Site header with navigation, theme switcher, and GitHub link.
 * Uses Blueprint components: bp-heading, bp-link, bp-select, bp-button, bp-icon
 */
---

<header class="site-header">
  <div class="header-content">
    <div class="header-left">
      <a href="/" class="logo-link">
        <svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true">
          <path
            class="logo-sheet"
            d="M10 0h24l14 14v24a10 10 0 0 1-10 10H10A10 10 0 0 1 0 38V10A10 10 0 0 1 10 0z"
          ></path>
          <path class="logo-fold" d="M34 0v10a4 4 0 0 0 4 4h10z"></path>
          <path class="logo-b" d="M16 10v28h10a8 8 0 0 0 0-16H16"></path>
        </svg>
        <bp-heading level="1" size="lg" weight="bold">Blueprint</bp-heading>
      </a>
    </div>

    <nav class="header-nav">
      <bp-link href="/getting-started/introduction">Docs</bp-link>
      <bp-link href="/components/accordion">Components</bp-link>
    </nav>

    <div class="header-right">
      <bp-select id="theme-switcher" size="sm">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </bp-select>

      <bp-link
        href="https://www.npmjs.com/package/@krollins/blueprint"
        size="sm">npm</bp-link
      >
      <bp-link href="https://github.com/KyleBlankRollins/blueprint" size="sm"
        >GitHub</bp-link
      >

      <button class="mobile-menu-toggle" aria-label="Toggle menu">
        <bp-icon name="menu-hamburger" size="md"></bp-icon>
      </button>
    </div>
  </div>
</header>

<script>
  // Theme switcher functionality
  document.addEventListener('DOMContentLoaded', () => {
    const themeSwitcher = document.getElementById(
      'theme-switcher'
    ) as HTMLSelectElement;
    if (themeSwitcher) {
      // Set initial value from current theme
      const currentTheme =
        document.documentElement.getAttribute('data-theme') || 'light';
      themeSwitcher.value = currentTheme;

      // Listen for bp-change event from bp-select custom element
      themeSwitcher.addEventListener('bp-change', (event: Event) => {
        const customEvent = event as CustomEvent;
        const theme = customEvent.detail.value;
        window.dispatchEvent(
          new CustomEvent('theme-change', {
            detail: { theme },
          })
        );
      });
    }

    // Mobile menu toggle
    const mobileToggle = document.querySelector('.mobile-menu-toggle');
    if (mobileToggle) {
      mobileToggle.addEventListener('click', () => {
        document.body.classList.toggle('sidebar-open');
      });
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bp-color-surface);
    border-bottom: 1px solid var(--bp-color-border);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    gap: 1.5rem;
  }

  .header-left {
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: var(--bp-spacing-xs);
    text-decoration: none;
  }

  /* Drawn inline so the mark follows the active theme */
  .logo-mark {
    width: var(--bp-spacing-8);
    height: var(--bp-spacing-8);
    flex-shrink: 0;
  }

  .logo-sheet {
    fill: var(--bp-color-primary);
  }

  .logo-fold {
    fill: color-mix(in oklch, var(--bp-color-primary) 70%, white);
  }

  .logo-b {
    fill: none;
    stroke: var(--bp-color-text-inverse);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .header-nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .header-right {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .header-right bp-divider {
    height: 1.5rem;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--bp-color-text);
  }

  @media (max-width: 768px) {
    .header-nav {
      display: none;
    }

    .header-right bp-select,
    .header-right bp-button {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }
  }
</style>
